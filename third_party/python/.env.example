# --------------------------------------------------------------------
# Environment template for the vendored Python dictation scripts.
#
# Copy to dictation.env (or the path pointed to by python.envFile in
# config.yaml) and edit. The bridge reads this file ONLY for the operational
# DICTATION_* keys below — never for secrets.
#
# D-05 INVARIANT: VOLCENGINE_TTS_* values MUST come from the live process
# environment (systemd EnvironmentFile, container env, etc.) — they are
# forwarded to the subprocess by pkg/pybridge via os.Getenv. NEVER put real
# secret values in this file. This file is tracked in git.
# --------------------------------------------------------------------

# Optional: override where the skill stores runtime data.
# DICTATION_DATA_DIR=/opt/hta/data
# DICTATION_DB_PATH=/opt/hta/data/vocab.db
# DICTATION_CACHE_DIR=/opt/hta/data/cache/audio
# DICTATION_MANIFEST_DIR=/opt/hta/data/cache

# Optional: force the Python interpreter used by legacy pregeneration.
# DICTATION_PYTHON=/opt/hta/venv/bin/python

# Optional: load TTS credentials from a specific env file. This SHOULD point
# to a deployment-managed, gitignored file — not this template.
# DICTATION_ENV_FILE=/etc/hta/dictation.secrets.env

# --------------------------------------------------------------------
# Volcengine TTS credentials (D-05: DEPLOYMENT ENV ONLY).
# DO NOT enter real values here. Configure them in the runtime environment
# (systemd EnvironmentFile, container -e, k8s Secret, etc.) so they never
# enter git history. The bridge picks them up via os.Getenv and forwards
# them to the subprocess.
# --------------------------------------------------------------------
# VOLCENGINE_TTS_API_KEY=
# VOLCENGINE_TTS_APP_ID=
# VOLCENGINE_TTS_ACCESS_KEY=
# Optional fallback for direct provider calls. Dictation modes select their
# required resource explicitly (TTS 1.0 fragments or TTS 2.0 contextual mode).
# VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
