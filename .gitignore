# Build output
/bin/
/dist/
*.exe

# Test artifacts
*.test
*.out
coverage.out
coverage.html

# Environment
.env
.env.local
# Local config.yaml (machine-specific paths, may hold non-secret config;
# secrets are never landed here per D-05 — they travel via live env). Never
# committed so local edits do not pollute git history.
/config.yaml

# Local HTTPS pre-acceptance channel (13-07 Task 2) — mkcert LAN cert/key
# plus the LAN-IP-bearing local config. Never committed (private key + LAN
# address hygiene, T-13-06d).
/.local-certs/
/config.local.yaml

# Python venv created by `make py-bootstrap` (D-04). Never committed — the
# venv is rebuilt on the deploy host from third_party/python/requirements.txt.
third_party/python/.venv/
third_party/python/.venv*/

# Logs
*.log

# OS
.DS_Store

# Vendor (use modules)
/vendor/

# UAT fix cycle hygiene (2026-09-24)
node_modules/

# Playwright browser-E2E artifacts (tests/e2e)
test-results/
# Machine-readable m1 run report (PLAYWRIGHT_JSON_OUTPUT_NAME, ci.yml job
# m1-browser-e2e / scripts/check-m1-report.mjs)
/reports/
playwright-report/
blob-report/
third_party/data/
third_party/python/__pycache__/
nul
*.exe~

# Scratch evidence (T-13-30): raw E2E artifacts — transcripts, JSONL timelines,
# result matrices, isolated-instance DBs/logs — never enter git history.
.scratch/


